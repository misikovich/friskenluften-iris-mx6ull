#!/bin/sh
set -eu

usage()
{
	echo "Usage: $0 [timeout-seconds|--tui-test]"
}

timeout="${1:-30}"
case "$timeout" in
	-h|--help)
		usage
		exit 0
		;;
	--tui-test) ;;
	''|*[!0-9]*)
		usage >&2
		exit 2
		;;
	*)
		[ "$timeout" -gt 0 ] || {
			echo "Timeout must be greater than zero." >&2
			exit 2
		}
		;;
esac
[ "$#" -le 1 ] || {
	usage >&2
	exit 2
}

i2c_device=
adapter=
polling=0
tui=0
current_step=controller
s_controller=PENDING
s_adapter=PENDING
s_service=PENDING
s_tag=PENDING
s_data=PENDING
tag_label="NFC tag detection"

if [ -t 1 ]; then
	cyan="$(printf '\033[1;36m')"
	green="$(printf '\033[1;32m')"
	gray="$(printf '\033[2;37m')"
	red="$(printf '\033[1;31m')"
	reset="$(printf '\033[0m')"
else
	cyan=
	green=
	gray=
	red=
	reset=
fi

tui_status()
{
	case "$1" in
		PASS) printf '%s[PASS]%s' "$green" "$reset" ;;
		FAIL) printf '%s[FAIL]%s' "$red" "$reset" ;;
		SKIP) printf '%s[SKIP]%s' "$cyan" "$reset" ;;
		*)    printf '%s-----%s' "$gray" "$reset" ;;
	esac
}

tui_line()
{
	printf '\033[%d;1H\033[2K| ' "$1"
	tui_status "$2"
	printf ' %-38s |' "$3"
}

tui_render()
{
	[ "$tui" -eq 1 ] || return 0
	printf '\0337\033[%d;1H\033[2K%s+ PN7150 NFC scan ----------------------------+%s' \
		"$tui_top" "$cyan" "$reset"
	tui_line "$((tui_top + 1))" "$s_controller" "I2C device and nxp-nci driver"
	tui_line "$((tui_top + 2))" "$s_adapter"    "Kernel NFC adapter"
	tui_line "$((tui_top + 3))" "$s_service"    "neard service and controller power"
	tui_line "$((tui_top + 4))" "$s_tag"        "$tag_label"
	tui_line "$((tui_top + 5))" "$s_data"       "NDEF record data"
	printf '\033[%d;1H\033[2K+-----------------------------------------------+\0338' \
		"$((tui_top + 6))"
}

set_status()
{
	current_step="$1"
	case "$1" in
		controller) s_controller="$2" ;;
		adapter)    s_adapter="$2" ;;
		service)    s_service="$2" ;;
		tag)        s_tag="$2" ;;
		data)       s_data="$2" ;;
	esac
	tui_render
}

tui_stop()
{
	[ "$tui" -eq 1 ] || return 0
	tui_render
	printf '\033[r\033[%d;1H\n' "$tui_rows"
	tui=0
}

terminal_rows()
{
	saved_stty="$(stty -g </dev/tty 2>/dev/null || true)"
	if [ -n "$saved_stty" ] &&
		stty -echo -icanon min 0 time 3 </dev/tty 2>/dev/null; then
		trap 'stty "$saved_stty" </dev/tty 2>/dev/null; exit 129' HUP
		trap 'stty "$saved_stty" </dev/tty 2>/dev/null; exit 130' INT
		trap 'stty "$saved_stty" </dev/tty 2>/dev/null; exit 143' TERM
		reply=
		if printf '\0337\033[999;999H\033[6n' >/dev/tty; then
			reply="$(dd if=/dev/tty bs=32 count=1 2>/dev/null || true)"
		fi
		printf '\0338' >/dev/tty || true
		stty "$saved_stty" </dev/tty 2>/dev/null || true
		trap - HUP INT TERM
		position="${reply##*\[}"
		row="${position%%;*}"
		case "$row" in
			''|*[!0-9]*) ;;
			*) [ "$row" -gt 0 ] && {
				printf '%s' "$row"
				return
			} ;;
		esac
	fi

	set -- $(stty size </dev/tty 2>/dev/null || true)
	row="${1:-0}"
	case "$row" in ''|*[!0-9]*) row=0 ;; esac
	[ "$row" -ne 0 ] || row=24
	printf '%s' "$row"
}

tui_start()
{
	[ -t 1 ] || return 0
	tui_rows="$(terminal_rows)"
	[ "$tui_rows" -ge 12 ] || return 0
	tui_top=$((tui_rows - 6))
	tui=1
	printf '\033[1;%dr\033[%d;1H' "$((tui_top - 1))" "$((tui_top - 1))"
	tui_render
}

info()
{
	printf '%sNFC scan: %s%s\n' "$cyan" "$*" "$reset"
}

pass()
{
	printf '%sNFC scan: PASS - %s%s\n' "$green" "$*" "$reset"
}

cleanup()
{
	if [ "$polling" -eq 1 ]; then
		gdbus call --system --timeout 2 --dest org.neard --object-path "$adapter" \
			--method org.neard.Adapter.StopPollLoop >/dev/null 2>&1 || true
	fi
	tui_stop
}

fail()
{
	set_status "$current_step" FAIL
	printf '%sNFC scan: FAIL - %s%s\n' "$red" "$*" "$reset" >&2
	dmesg | grep -Ei 'nfc|nxp.nci|i2c.*0029|i2c4' | tail -n 30 >&2 || true
	exit 1
}

trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

tui_start

if [ "${1:-}" = --tui-test ]; then
	[ "$tui" -eq 1 ] || fail "TUI test requires a terminal"
	set_status controller PASS
	set_status adapter PASS
	set_status service PASS
	set_status tag PASS
	set_status data SKIP
	pass "sample NFC tag detected"
	echo "Controller: 3-0029"
	echo "Adapter:    /org/neard/nfc0"
	echo "Tag:        /org/neard/nfc0/tag0"
	echo "UID:        04:A1:B2:C3:D4:E5:80"
	echo "NDEF:       no records"
	exit 0
fi

info "checking I2C4 and the PN7150"
for candidate in /sys/bus/i2c/devices/*-0029; do
	[ -d "$candidate" ] || continue
	i2c_device="$candidate"
	break
done
[ -n "$i2c_device" ] || fail "PN7150 I2C device at address 0x29 is absent"

if [ ! -L "$i2c_device/driver" ]; then
	info "loading the nxp_nci_i2c driver"
	modprobe nxp_nci_i2c || fail "cannot load nxp_nci_i2c"
	seconds=0
	while [ ! -L "$i2c_device/driver" ] && [ "$seconds" -lt 5 ]; do
		sleep 1
		seconds=$((seconds + 1))
	done
fi
[ -L "$i2c_device/driver" ] || fail "nxp_nci_i2c did not bind to the PN7150"
driver="$(basename "$(readlink -f "$i2c_device/driver")")"
[ "$driver" = nxp-nci_i2c ] || fail "PN7150 is bound to $driver, not nxp-nci_i2c"
set_status controller PASS

set_status adapter PENDING
seconds=0
while :; do
	for nfc_class in /sys/class/nfc/nfc*; do
		[ -d "$nfc_class" ] || continue
		nfc_name="${nfc_class##*/}"
		break 2
	done
	[ "$seconds" -lt 5 ] || fail "PN7150 created no kernel NFC adapter"
	sleep 1
	seconds=$((seconds + 1))
done
set_status adapter PASS

set_status service PENDING
command -v gdbus >/dev/null || fail "gdbus is not installed"
if ! pidof neard >/dev/null 2>&1; then
	info "starting neard"
	/etc/init.d/S53neard start || fail "cannot start neard"
	sleep 1
fi
objects="$(gdbus call --system --timeout 5 --dest org.neard --object-path / \
	--method org.freedesktop.DBus.ObjectManager.GetManagedObjects 2>&1)" || {
	printf '%s\n' "$objects" >&2
	fail "cannot query neard objects"
}
adapter="$(printf '%s\n' "$objects" |
	sed -n "s|.*'\\(/org/neard/nfc[0-9][0-9]*\\)'.*|\\1|p" |
	sed -n '1p')"
[ -n "$adapter" ] || {
	printf '%s\n' "$objects" >&2
	fail "neard exposes no NFC adapter"
}
[ "${adapter##*/}" = "$nfc_name" ] ||
	fail "kernel adapter $nfc_name does not match neard adapter $adapter"
power_result="$(gdbus call --system --timeout 7 --dest org.neard \
	--object-path "$adapter" --method org.freedesktop.DBus.Properties.Set \
	org.neard.Adapter Powered '<true>' 2>&1)" || case "$power_result" in
	*"already enabled"*) ;;
	*)
		printf '%s\n' "$power_result" >&2
		fail "PN7150 did not power on"
		;;
esac
powered="$(gdbus call --system --timeout 5 --dest org.neard \
	--object-path "$adapter" --method org.freedesktop.DBus.Properties.Get \
	org.neard.Adapter Powered 2>&1)" || {
	printf '%s\n' "$powered" >&2
	fail "cannot read NFC adapter power state"
}
case "$powered" in
	*true*) ;;
	*) fail "neard left the NFC adapter powered off" ;;
esac
set_status service PASS

set_status tag PENDING
gdbus call --system --timeout 2 --dest org.neard --object-path "$adapter" \
	--method org.neard.Adapter.StopPollLoop >/dev/null 2>&1 || true
gdbus call --system --timeout 5 --dest org.neard --object-path "$adapter" \
	--method org.neard.Adapter.StartPollLoop Initiator >/dev/null 2>&1 ||
	fail "neard could not start NFC polling"
polling=1
seconds=0
tag=
while [ "$seconds" -lt "$timeout" ]; do
	objects="$(gdbus call --system --timeout 2 --dest org.neard --object-path / \
		--method org.freedesktop.DBus.ObjectManager.GetManagedObjects 2>&1)" ||
		fail "cannot query neard while polling"
	tag="$(printf '%s\n' "$objects" |
		sed -n "s|.*'\\(/org/neard/nfc[0-9][0-9]*/tag[0-9][0-9]*\\)'.*|\\1|p" |
		sed -n '1p')"
	[ -z "$tag" ] || break
	seconds=$((seconds + 1))
	tag_label="$(printf 'NFC tag detection %2d/%d s' "$seconds" "$timeout")"
	tui_render
	if [ "$tui" -eq 0 ]; then
		printf '\r%sNFC scan: waiting for a tag %2d/%d seconds%s' \
			"$cyan" "$seconds" "$timeout" "$reset"
	fi
	sleep 1
done
[ "$tui" -eq 1 ] || printf '\n'
[ -n "$tag" ] || fail "no NFC tag detected within $timeout seconds"
tag_label="NFC tag detection"
set_status tag PASS

sleep 1
tag_properties="$(gdbus call --system --timeout 5 --dest org.neard --object-path "$tag" \
	--method org.freedesktop.DBus.Properties.GetAll org.neard.Tag 2>&1)" ||
	fail "cannot read NFC tag properties"
uid="$(printf '%s\n' "$tag_properties" |
	sed -n "s/.*'Uid': <\[\([^]]*\)\]>.*/\1/p" |
	sed 's/byte //g; s/0x//g; s/, /:/g' | tr '[:lower:]' '[:upper:]')"

record_paths="$(printf '%s\n' "$tag_properties" |
	sed -n "s/.*'Records': <\\[\\([^]]*\\)\\]>.*/\\1/p" |
	sed "s/objectpath '//g; s/'//g; s/,/ /g")"
if [ -n "$record_paths" ]; then
	set_status data PASS
else
	set_status data SKIP
fi

gdbus call --system --timeout 2 --dest org.neard --object-path "$adapter" \
	--method org.neard.Adapter.StopPollLoop >/dev/null 2>&1 || true
polling=0

pass "NFC tag detected"
echo "Controller: ${i2c_device##*/}"
echo "Driver:     $driver"
echo "Adapter:    $adapter"
echo "Tag:        $tag"
[ -z "$uid" ] || echo "UID:        $uid"
echo
echo "Tag properties:"
printf '%s\n' "$tag_properties"

if [ -n "$record_paths" ]; then
	echo
	echo "NDEF records:"
	for record in $record_paths; do
		echo
		echo "Record: $record"
		gdbus call --system --timeout 5 --dest org.neard --object-path "$record" \
			--method org.freedesktop.DBus.Properties.GetAll org.neard.Record ||
			fail "cannot read NDEF record $record"
	done
else
	echo "NDEF:       no records"
fi
