#!/bin/sh
set -eu

[ "$#" -le 1 ] || {
	echo "Usage: $0 [peer-IP|--tui-test]" >&2
	exit 2
}
case "${1:-}" in
	--tui-test) ;;
	-*) echo "Peer IP must not begin with '-'." >&2; exit 2 ;;
esac

spi=/sys/bus/spi/devices/spi0.0
iface=
tui=0
current_step=spi
s_spi=PENDING
s_sync=PENDING
s_identity=PENDING
s_remote=PENDING
s_rates=PENDING
s_ipv4=PENDING
s_peer=PENDING

if [ -t 1 ]; then
	cyan="$(printf '\033[1;36m')"
	green="$(printf '\033[1;32m')"
	gray="$(printf '\033[2;37m')"
	red="$(printf '\033[1;31m')"
	reset="$(printf '\033[0m')"
else
	cyan=
	green=
	gray=
	red=
	reset=
fi

tui_status()
{
	case "$1" in
		PASS) printf '%s[PASS]%s' "$green" "$reset" ;;
		FAIL) printf '%s[FAIL]%s' "$red" "$reset" ;;
		SKIP) printf '%s[SKIP]%s' "$cyan" "$reset" ;;
		*)    printf '%s-----%s' "$gray" "$reset" ;;
	esac
}

tui_line()
{
	printf '\033[%d;1H\033[2K| ' "$1"
	tui_status "$2"
	printf ' %-38s |' "$3"
}

tui_render()
{
	[ "$tui" -eq 1 ] || return 0
	printf '\0337\033[%d;1H\033[2K%s+ Grid PLC verification ----------------------+%s' \
		"$tui_top" "$cyan" "$reset"
	tui_line "$((tui_top + 1))" "$s_spi"      "SPI device and qcaspi driver"
	tui_line "$((tui_top + 2))" "$s_sync"     "SPI synchronization"
	tui_line "$((tui_top + 3))" "$s_identity" "Local PLC identity"
	tui_line "$((tui_top + 4))" "$s_remote"   "Remote PLC association"
	tui_line "$((tui_top + 5))" "$s_rates"    "PLC PHY rates"
	tui_line "$((tui_top + 6))" "$s_ipv4"     "IPv4 host discovery"
	tui_line "$((tui_top + 7))" "$s_peer"     "Known peer ping"
	printf '\033[%d;1H\033[2K+-----------------------------------------------+\0338' \
		"$((tui_top + 8))"
}

set_status()
{
	current_step="$1"
	case "$1" in
		spi)      s_spi="$2" ;;
		sync)     s_sync="$2" ;;
		identity) s_identity="$2" ;;
		remote)   s_remote="$2" ;;
		rates)    s_rates="$2" ;;
		ipv4)     s_ipv4="$2" ;;
		peer)     s_peer="$2" ;;
	esac
	tui_render
}

tui_stop()
{
	[ "$tui" -eq 1 ] || return 0
	tui_render
	printf '\033[r\033[%d;1H\n' "$tui_rows"
	tui=0
}

terminal_rows()
{
	case "${PLC_TUI_ROWS:-}" in
		''|*[!0-9]*) ;;
		*) [ "$PLC_TUI_ROWS" -gt 0 ] && {
			printf '%s' "$PLC_TUI_ROWS"
			return
		} ;;
	esac

	saved_stty="$(stty -g </dev/tty 2>/dev/null || true)"
	if [ -n "$saved_stty" ] &&
		stty -echo -icanon min 0 time 3 </dev/tty 2>/dev/null; then
		trap 'stty "$saved_stty" </dev/tty 2>/dev/null; exit 129' HUP
		trap 'stty "$saved_stty" </dev/tty 2>/dev/null; exit 130' INT
		trap 'stty "$saved_stty" </dev/tty 2>/dev/null; exit 143' TERM
		reply=
		if printf '\0337\033[999;999H\033[6n' >/dev/tty; then
			reply="$(dd if=/dev/tty bs=32 count=1 2>/dev/null || true)"
		fi
		printf '\0338' >/dev/tty || true
		stty "$saved_stty" </dev/tty 2>/dev/null || true
		trap - HUP INT TERM
		position="${reply##*\[}"
		row="${position%%;*}"
		case "$row" in
			''|*[!0-9]*) ;;
			*) [ "$row" -gt 0 ] && {
				printf '%s' "$row"
				return
			} ;;
		esac
	fi

	set -- $(stty size 2>/dev/null || true)
	row="${1:-0}"
	case "$row" in ''|*[!0-9]*) row=0 ;; esac
	[ "$row" -ne 0 ] || row=24
	printf '%s' "$row"
}

tui_start()
{
	[ -t 1 ] || return 0
	[ "$#" -eq 1 ] || s_peer=SKIP
	tui_rows="$(terminal_rows)"
	[ "$tui_rows" -ge 14 ] || return 0
	tui_top=$((tui_rows - 8))
	tui=1
	printf '\033[1;%dr\033[%d;1H' "$((tui_top - 1))" "$((tui_top - 1))"
	trap tui_stop 0
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	tui_render
}

info()
{
	printf '%sGrid PLC: %s%s\n' "$cyan" "$*" "$reset"
}

pass()
{
	printf '%sGrid PLC: PASS - %s%s\n' "$green" "$*" "$reset"
}

fail()
{
	set_status "$current_step" FAIL
	printf '%sGrid PLC: FAIL - %s%s\n' "$red" "$*" "$reset" >&2
	[ -z "$iface" ] || {
		ethtool -S "$iface" >&2 || true
	}
	dmesg | grep -Ei 'qca|spi0\.0|ecspi' | tail -n 20 >&2 || true
	exit 1
}

tui_start "$@"

if [ "${1:-}" = --tui-test ]; then
	[ "$tui" -eq 1 ] || fail "TUI test requires a terminal"
	set_status spi PASS
	set_status sync PASS
	set_status identity FAIL
	set_status peer SKIP
	exit 0
fi

info "checking ECSPI1, qcaspi, and the QCA7005"
[ -d "$spi" ] || fail "ECSPI1 device spi0.0 is absent"

if [ ! -L "$spi/driver" ]; then
	info "loading the qcaspi driver"
	modprobe qcaspi || fail "cannot load qcaspi"
	seconds=0
	while [ ! -L "$spi/driver" ] && [ "$seconds" -lt 5 ]; do
		sleep 1
		seconds=$((seconds + 1))
	done
fi
[ -L "$spi/driver" ] || fail "qcaspi did not bind to spi0.0"

driver="$(basename "$(readlink -f "$spi/driver")")"
[ "$driver" = qcaspi ] || fail "spi0.0 is bound to $driver, not qcaspi"

for netdev in "$spi"/net/*; do
	[ -d "$netdev" ] || continue
	iface="${netdev##*/}"
	break
done
[ -n "$iface" ] || fail "qcaspi created no network interface"
set_status spi PASS

set_status sync PENDING
ip link set dev "$iface" up || fail "cannot bring up $iface"
seconds=0
if [ "$(cat "/sys/class/net/$iface/carrier")" != 1 ]; then
	info "waiting up to 15 seconds for SPI synchronization"
fi
while [ "$(cat "/sys/class/net/$iface/carrier")" != 1 ] &&
	[ "$seconds" -lt 15 ]; do
	printf '\r%sGrid PLC: synchronization wait %2d/15 seconds%s' \
		"$cyan" "$seconds" "$reset"
	sleep 1
	seconds=$((seconds + 1))
done
[ "$seconds" -eq 0 ] || printf '\r%sGrid PLC: synchronization wait %2d/15 seconds%s\n' \
	"$cyan" "$seconds" "$reset"
[ "$(cat "/sys/class/net/$iface/carrier")" = 1 ] ||
	fail "QCA7005 did not synchronize over SPI within 15 seconds"
set_status sync PASS

pass "QCA7005 is present and synchronized"
echo "SPI device: spi0.0"
echo "Driver:     $driver"
echo "Interface:  $iface"
ethtool -i "$iface" || true
ethtool -S "$iface" || true

set_status identity PENDING
command -v plctool >/dev/null || fail "plctool is not installed"
info "reading QCA7005 identity, link, and network membership"
plctool -i "$iface" -r -L -m || fail "QCA7005 management query failed"
set_status identity PASS

set_status remote PENDING
command -v plcstat >/dev/null || fail "plcstat is not installed"
info "checking for a remote Grid PLC station"
if ! topology="$(plcstat -i "$iface" -t 2>&1)"; then
	printf '%s\n' "$topology" >&2
	fail "PLC topology query failed"
fi
printf '%s\n' "$topology"
printf '%s\n' "$topology" | grep -q '^ LOC' ||
	fail "local QCA7005 did not answer the topology query"
printf '%s\n' "$topology" | grep -q '^ REM' ||
	fail "no remote Grid PLC station is associated"
set_status remote PASS

set_status rates PENDING
command -v plcrate >/dev/null || fail "plcrate is not installed"
info "checking three PLC PHY-rate samples"
plcrate -i "$iface" -l 3 -w 1 -x || fail "PLC PHY rate is zero or unavailable"
set_status rates PASS
pass "local and remote PLC stations are communicating"

set_status ipv4 PENDING
if ifconfig "$iface" | grep -q 'inet '; then
	command -v arp-scan >/dev/null || fail "arp-scan is not installed"
	info "discovering IPv4 hosts on the PLC network"
	arp-scan --interface="$iface" --localnet || fail "ARP discovery failed"
	set_status ipv4 PASS
	pass "ARP discovery completed"
else
	set_status ipv4 SKIP
	info "no IPv4 address on $iface; skipping ARP discovery"
	info "run udhcpc -i $iface -n -q, then run this check again"
fi

if [ "$#" -eq 1 ]; then
	set_status peer PENDING
	info "pinging PLC peer $1"
	ping -I "$iface" -c 3 -W 2 "$1" ||
		fail "PLC peer $1 did not answer"
	set_status peer PASS
	pass "PLC network peer $1 is responding"
fi
