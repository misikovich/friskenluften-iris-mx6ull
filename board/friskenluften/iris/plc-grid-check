#!/usr/bin/env python3
"""Verify the Grid PLC path: ECSPI1 -> qcaspi -> QCA7005 -> remote station."""

import os
import re
import select
import shutil
import signal
import subprocess
import sys
import termios
import time

SPI_DEV = "/sys/bus/spi/devices/spi0.0"
SYNC_TIMEOUT = 15

STEPS = [
    ("spi", "SPI device and qcaspi driver"),
    ("sync", "SPI synchronization"),
    ("identity", "Local PLC identity"),
    ("remote", "Remote PLC association"),
    ("rates", "PLC PHY rates"),
    ("ipv4", "IPv4 host discovery"),
    ("peer", "Known peer ping"),
]

# qcaspi ethtool counters: what a nonzero value usually points at.
COUNTER_HINTS = {
    "Triggered resets": "driver reset the QCA7005 after losing SPI sync",
    "Reset timeouts": "QCA7005 did not come back after a reset "
                      "(power, reset line GPIO3_IO01, or firmware crash)",
    "Read errors": "SPI read transfers failed on ECSPI1",
    "Write errors": "SPI write transfers failed on ECSPI1",
    "Read buffer errors": "QCA7005 reported a read buffer error "
                          "(corrupted SPI data)",
    "Write buffer errors": "QCA7005 reported a write buffer error "
                           "(corrupted SPI data)",
    "SPI errors": "QCA7005 flagged SPI protocol errors (signal integrity, "
                  "wrong SPI mode, or clock too fast)",
    "Write verify errors": "register write read-back mismatched "
                           "(SPI signal integrity)",
    "Buffer available errors": "QCA7005 reported an impossible buffer size "
                               "(corrupted SPI reads)",
    "Bad signature": "QCA7005 signature register read back wrong "
                     "(MISO/MOSI/CLK/CS wiring, SPI mode, or chip not powered)",
}

if sys.stdout.isatty():
    CYAN, GREEN, GRAY, RED, YELLOW, RESET = (
        "\033[1;36m", "\033[1;32m", "\033[2;37m", "\033[1;31m",
        "\033[1;33m", "\033[0m")
else:
    CYAN = GREEN = GRAY = RED = YELLOW = RESET = ""


class CheckFailed(Exception):
    """A failed step with a plain-language explanation."""

    def __init__(self, summary, meaning="", actions=(), raw=""):
        super().__init__(summary)
        self.summary = summary
        self.meaning = meaning
        self.actions = list(actions)
        self.raw = raw


class Skipped(Exception):
    pass


def info(msg):
    print(f"{CYAN}Grid PLC: {msg}{RESET}", flush=True)


def passed(msg):
    print(f"{GREEN}Grid PLC: PASS - {msg}{RESET}", flush=True)


class StatusPanel:
    """Fixed status box at the bottom of the terminal; logs scroll above it."""

    WIDTH = 49

    def __init__(self):
        self.status = {key: "PENDING" for key, _ in STEPS}
        self.active = False
        self.top = 0
        self.rows = 0

    def start(self):
        if not sys.stdout.isatty():
            return
        self.rows = terminal_rows()
        if self.rows < 14:
            return
        self.top = self.rows - len(STEPS) - 1
        self.active = True
        sys.stdout.write(f"\033[1;{self.top - 1}r\033[{self.top - 1};1H")
        self.render()

    def stop(self):
        if not self.active:
            return
        self.render()
        sys.stdout.write(f"\033[r\033[{self.rows};1H\n")
        sys.stdout.flush()
        self.active = False

    def set(self, key, state):
        self.status[key] = state
        self.render()

    def render(self):
        if not self.active:
            return
        badge = {
            "PASS": f"{GREEN}[PASS]{RESET}",
            "FAIL": f"{RED}[FAIL]{RESET}",
            "SKIP": f"{CYAN}[SKIP]{RESET}",
        }
        title = " Grid PLC verification "
        out = ["\0337", f"\033[{self.top};1H\033[2K{CYAN}+"
               f"{title}{'-' * (self.WIDTH - len(title) - 2)}+{RESET}"]
        for i, (key, label) in enumerate(STEPS, 1):
            state = badge.get(self.status[key], f"{GRAY}------{RESET}")
            out.append(f"\033[{self.top + i};1H\033[2K| {state} {label:<38} |")
        out.append(f"\033[{self.top + len(STEPS) + 1};1H\033[2K+"
                   f"{'-' * (self.WIDTH - 2)}+\0338")
        sys.stdout.write("".join(out))
        sys.stdout.flush()


def terminal_rows():
    """Serial consoles report 0x0, so fall back to asking the terminal."""
    env = os.environ.get("PLC_TUI_ROWS", "")
    if env.isdigit() and int(env) > 0:
        return int(env)
    try:
        rows = os.get_terminal_size(sys.stdout.fileno()).lines
        if rows > 0:
            return rows
    except OSError:
        pass
    try:
        with open("/dev/tty", "r+b", buffering=0) as tty:
            saved = termios.tcgetattr(tty)
            new = termios.tcgetattr(tty)
            new[3] &= ~(termios.ECHO | termios.ICANON)
            try:
                termios.tcsetattr(tty, termios.TCSANOW, new)
                tty.write(b"\0337\033[999;999H\033[6n\0338")
                reply = b""
                while select.select([tty], [], [], 0.3)[0]:
                    reply += tty.read(32)
                    if reply.endswith(b"R"):
                        break
            finally:
                termios.tcsetattr(tty, termios.TCSANOW, saved)
        match = re.search(rb"\[(\d+);\d+R", reply)
        if match:
            return int(match.group(1))
    except OSError:
        pass
    return 24


def run(cmd, timeout=30):
    """Run a tool; return (exit code, combined output)."""
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True,
                             timeout=timeout)
    except FileNotFoundError:
        raise CheckFailed(
            f"{cmd[0]} is not installed",
            "The image was built without the package that provides it.",
            [f"enable the package providing {cmd[0]} in "
             "friskenluften_iris_defconfig and rebuild"])
    except subprocess.TimeoutExpired as exc:
        out = exc.output or ""
        if isinstance(out, bytes):
            out = out.decode(errors="replace")
        return 124, out + f"\n{cmd[0]}: timed out after {timeout} s\n"
    return res.returncode, res.stdout


def read_sysfs(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def qcaspi_counters(iface):
    code, out = run(["ethtool", "-S", iface])
    counters = {}
    if code == 0:
        for line in out.splitlines():
            name, sep, value = line.rpartition(":")
            if sep and value.strip().isdigit():
                counters[name.strip()] = int(value)
    return counters


class GridCheck:
    def __init__(self, panel, peer):
        self.panel = panel
        self.peer = peer
        self.iface = None
        self.step = "spi"

    def begin(self, step):
        self.step = step
        self.panel.set(step, "PENDING")

    # --- steps ---------------------------------------------------------

    def check_spi(self):
        info("checking ECSPI1, qcaspi, and the QCA7005")
        if not os.path.isdir(SPI_DEV):
            raise CheckFailed(
                "ECSPI1 device spi0.0 is absent",
                "The kernel did not create the SPI device for the QCA7005.",
                ["confirm &ecspi1 and its qca,qca7000 child are enabled in "
                 "the running DTB",
                 "check that CONFIG_SPI_IMX is built in"])
        driver_link = os.path.join(SPI_DEV, "driver")
        if not os.path.islink(driver_link):
            info("loading the qcaspi driver")
            code, out = run(["modprobe", "qcaspi"])
            if code != 0:
                raise CheckFailed(
                    "cannot load qcaspi",
                    "The QCA7000 SPI driver module is missing or failed "
                    "to load.",
                    ["check CONFIG_QCA7000_SPI=m and that modules are "
                     "installed"], out)
            for _ in range(5):
                if os.path.islink(driver_link):
                    break
                time.sleep(1)
        if not os.path.islink(driver_link):
            raise CheckFailed(
                "qcaspi did not bind to spi0.0",
                "The driver loaded but refused the device; its probe "
                "failed.",
                ["look for qcaspi probe errors in the dmesg lines below",
                 "verify the interrupt (GPIO3_IO00) and SPI properties "
                 "in the DT"])
        driver = os.path.basename(os.path.realpath(driver_link))
        if driver != "qcaspi":
            raise CheckFailed(
                f"spi0.0 is bound to {driver}, not qcaspi",
                "Another driver claimed the SPI device.",
                ["check the compatible string of the ECSPI1 child node"])
        net_dir = os.path.join(SPI_DEV, "net")
        ifaces = sorted(os.listdir(net_dir)) if os.path.isdir(net_dir) else []
        if not ifaces:
            raise CheckFailed(
                "qcaspi created no network interface",
                "The driver bound but did not register an Ethernet "
                "device.",
                ["check dmesg for register_netdev errors"])
        self.iface = ifaces[0]

    def check_sync(self):
        iface = self.iface
        code, out = run(["ip", "link", "set", "dev", iface, "up"])
        if code != 0:
            raise CheckFailed(f"cannot bring up {iface}", raw=out)
        carrier = f"/sys/class/net/{iface}/carrier"
        waited = 0
        if read_sysfs(carrier) != "1":
            info(f"waiting up to {SYNC_TIMEOUT} seconds for SPI "
                 "synchronization")
            while read_sysfs(carrier) != "1" and waited < SYNC_TIMEOUT:
                print(f"\r{CYAN}Grid PLC: synchronization wait "
                      f"{waited:2d}/{SYNC_TIMEOUT} seconds{RESET}",
                      end="", flush=True)
                time.sleep(1)
                waited += 1
            print(f"\r{CYAN}Grid PLC: synchronization wait "
                  f"{waited:2d}/{SYNC_TIMEOUT} seconds{RESET}", flush=True)
        if read_sysfs(carrier) != "1":
            raise CheckFailed(
                f"QCA7005 did not synchronize over SPI within "
                f"{SYNC_TIMEOUT} seconds",
                "The driver cannot read a valid signature from the chip, "
                "so it never reports carrier.",
                ["check QCA7005 power and that reset (GPIO3_IO01) is "
                 "released",
                 "check SPI wiring and chip select GPIO4_IO26",
                 "see the nonzero counters below for the failure type"])
        passed("QCA7005 is present and synchronized")
        print(f"SPI device: spi0.0\nInterface:  {iface}")
        print(run(["ethtool", "-i", iface])[1], end="")

    def check_identity(self):
        info("reading QCA7005 identity, link, and network membership")
        code, out = run(["plctool", "-i", self.iface, "-r", "-L", "-m"])
        print(out, end="")
        if code != 0:
            raise CheckFailed(
                "QCA7005 management query failed",
                "SPI works, but the chip did not answer HomePlug "
                "management messages.",
                ["check that the QCA7005 host interface is configured "
                 "for SPI",
                 "rerun after a reset: /etc/init.d/S09plc-grid-reset "
                 "restart"])
        if re.search(r"\bBootLoader\b", out):
            raise CheckFailed(
                "QCA7005 is running its ROM bootloader, not PLC firmware",
                "The chip answered only as 'BootLoader': no PLC firmware "
                "(.nvm) and parameter block (.pib) are running. The "
                "bootloader handles basic version queries but has no "
                "powerline stack, so it cannot join a network or answer "
                "topology and rate queries.",
                ["if the QCA7005 has its own SPI flash: it is blank or "
                 "holds invalid firmware; program a QCA7005 .nvm and "
                 "board .pib into it",
                 "if it has no flash: the host must load them after every "
                 "reset (open-plc-utils plcboot -i "
                 f"{self.iface} -N <fw>.nvm -P <board>.pib)",
                 "check the QCA7005 boot-strap pins against the schematic"])
        version = [line.split(None, 2)[2] for line in out.splitlines()
                   if len(line.split(None, 2)) == 3
                   and not re.search(r"\b(Request|Fetch)\b", line)]
        if version:
            info(f"firmware: {version[0]}")

    def check_remote(self):
        info("checking for a remote Grid PLC station")
        code, out = run(["plcstat", "-i", self.iface, "-t"])
        print(out, end="")
        if code != 0 or not re.search(r"^ LOC", out, re.M):
            raise CheckFailed(
                "local QCA7005 did not answer the topology query",
                "The PLC firmware did not return network topology. This "
                "normally means the firmware is not running or crashed.",
                ["rerun after a reset: /etc/init.d/S09plc-grid-reset "
                 "restart",
                 "check dmesg below for qcaspi resets"])
        if not re.search(r"^ REM", out, re.M):
            raise CheckFailed(
                "no remote Grid PLC station is associated",
                "The local chip is running but has not joined a PLC "
                "network with another station.",
                ["check that the grid-side PLC modem is powered and "
                 "coupled to the same line",
                 "check that both stations use the same network "
                 "membership key (NMK)",
                 "check the coupling circuit between the QCA7005 and "
                 "the line"])

    def check_rates(self):
        info("checking three PLC PHY-rate samples")
        code, out = run(["plcrate", "-i", self.iface, "-l", "3", "-w", "1",
                         "-x"])
        print(out, end="")
        if code != 0:
            raise CheckFailed(
                "PLC PHY rate is zero or unavailable",
                "The stations are associated, but no usable data rate "
                "was negotiated.",
                ["check line coupling and noise on the PLC path",
                 "check that the tone mask in both .pib files matches"])
        passed("local and remote PLC stations are communicating")

    def check_ipv4(self):
        code, out = run(["ip", "-4", "addr", "show", "dev", self.iface])
        if "inet " not in out:
            info(f"no IPv4 address on {self.iface}; skipping ARP discovery")
            info(f"run udhcpc -i {self.iface} -n -q, then run this check "
                 "again")
            raise Skipped()
        info("discovering IPv4 hosts on the PLC network")
        code, out = run(["arp-scan", f"--interface={self.iface}",
                         "--localnet"], timeout=60)
        print(out, end="")
        if code != 0:
            raise CheckFailed("ARP discovery failed", raw=out)
        passed("ARP discovery completed")

    def check_peer(self):
        if self.peer is None:
            raise Skipped()
        info(f"pinging PLC peer {self.peer}")
        code, out = run(["ping", "-I", self.iface, "-c", "3", "-W", "2",
                         self.peer])
        print(out, end="")
        if code != 0:
            raise CheckFailed(
                f"PLC peer {self.peer} did not answer",
                "The PLC link is up, but IP traffic to the peer failed.",
                ["check that the peer is on the same subnet and "
                 "answers ICMP"])
        passed(f"PLC network peer {self.peer} is responding")

    # --- driver --------------------------------------------------------

    def run_all(self):
        for key, _ in STEPS:
            self.begin(key)
            try:
                getattr(self, f"check_{key}")()
            except Skipped:
                self.panel.set(key, "SKIP")
                continue
            self.panel.set(key, "PASS")

    def report(self, err):
        self.panel.set(self.step, "FAIL")
        label = dict(STEPS)[self.step]
        e = sys.stderr
        print(f"{RED}Grid PLC: FAIL - {err.summary}{RESET}", file=e)
        print(f"  Step:    {label}", file=e)
        if err.meaning:
            print(f"  Meaning: {err.meaning}", file=e)
        for i, action in enumerate(err.actions):
            print(f"  {'Check:' if i == 0 else '':<8} - {action}", file=e)
        if err.raw.strip():
            print("  Tool output:", file=e)
            for line in err.raw.rstrip().splitlines():
                print(f"    {line}", file=e)
        if self.iface:
            counters = qcaspi_counters(self.iface)
            flagged = [(n, v) for n, v in counters.items()
                       if v and n in COUNTER_HINTS]
            resets = counters.get("Device resets", 0)
            if resets > 1:
                flagged.append(("Device resets",
                                f"{resets} (1 at boot is normal; more means "
                                "the chip is rebooting)"))
            if flagged:
                print(f"{YELLOW}  Nonzero qcaspi error counters:{RESET}",
                      file=e)
                for name, value in flagged:
                    hint = COUNTER_HINTS.get(name, "")
                    print(f"    {name}: {value}"
                          + (f" - {hint}" if hint else ""), file=e)
            elif counters:
                print("  qcaspi error counters: all zero (SPI link is "
                      "clean)", file=e)
        code, out = run(["dmesg"])
        lines = [line for line in out.splitlines()
                 if re.search(r"qca|spi0\.0|ecspi", line, re.I)][-20:]
        if lines:
            print("  Recent kernel messages:", file=e)
            for line in lines:
                print(f"    {line}", file=e)
        e.flush()


def usage():
    print(f"Usage: {os.path.basename(sys.argv[0])} [peer-IP|--tui-test]",
          file=sys.stderr)
    sys.exit(2)


def main():
    # Keep tool output ordered with stderr reports when piped or logged.
    sys.stdout.reconfigure(line_buffering=True)
    args = sys.argv[1:]
    if len(args) > 1:
        usage()
    arg = args[0] if args else None
    if arg and arg != "--tui-test" and arg.startswith("-"):
        print("Peer IP must not begin with '-'.", file=sys.stderr)
        sys.exit(2)

    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda n, _f: sys.exit(128 + n))

    panel = StatusPanel()
    if arg is None:
        panel.status["peer"] = "SKIP"
    panel.start()
    try:
        if arg == "--tui-test":
            if not panel.active:
                print("Grid PLC: FAIL - TUI test requires a terminal",
                      file=sys.stderr)
                return 1
            for key, state in (("spi", "PASS"), ("sync", "PASS"),
                               ("identity", "FAIL"), ("peer", "SKIP")):
                time.sleep(0.3)
                panel.set(key, state)
            return 0
        check = GridCheck(panel, arg)
        try:
            check.run_all()
        except CheckFailed as err:
            check.report(err)
            return 1
        return 0
    except KeyboardInterrupt:
        return 130
    finally:
        panel.stop()


if __name__ == "__main__":
    sys.exit(main())
